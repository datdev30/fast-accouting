# Environment Variables
MONGODB_URI=mongodb://localhost:27017/fastaccounting
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
NODE_ENV=development
PORT=3000

# CORS Origin (for production)
CORS_ORIGIN=http://localhost:5173

# Google Drive
DRIVE_TRANSACTION_IMAGES_FOLDER_ID=your_drive_folder_id
GOOGLE_DRIVE_OAUTH_CLIENT_ID=your_oauth_client_id
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=your_oauth_refresh_token
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://localhost:53682/oauth2callback

# Optional: set to 1 to include Drive error details in API responses (use temporarily for debugging)
DRIVE_DEBUG=0
